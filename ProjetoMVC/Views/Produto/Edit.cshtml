@{
	ViewData["Title"] = "Produtos";
}
@model ProjetoMVC.Models.Produto

	<div class="text-center">
		<h1>CRUD de Produtos</h1>
		<form asp-action="Edit" method="post">
			<label>ID</label>
			<input asp-for="Id" />
			<label>NOME</label>
			<input asp-for="Nome" />
			<label>CATEGORIA</label>
			<input asp-for="Categoria" />
			<label>PREÇO</label>
			<input asp-for="Preco" />
		<label asp-for="FornecedorId" asp-items="ViewBag.FornecedorId"></label>
		<select asp-for="FornecedorId" asp-items="ViewBag.FornecedorId"></select>
		<button type="submit">Salvar</button>
		</form>
	</div>