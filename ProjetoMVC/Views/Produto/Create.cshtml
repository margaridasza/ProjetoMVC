@{
	ViewData["Title"] = "Produtos";
}
@model ProjetoMVC.Models.Produto

	<div class="text-center">
		<h1>CRUD de Produtos</h1>
		<form asp-action="Create" method="post">
			<label>ID</label>
			<input asp-for="Id" />
			<label>NOME</label>
			<input asp-for="Nome" />
			<label>CATEGORIA</label>
			<input asp-for="Categoria" />
			<label>PREÇO</label>
			<input asp-for="Preco" />
			<label asp-for="FornecedorId" asp-items="ViewBag.FornecedorId"></label>
			<select asp-for="FornecedorId" asp-items="ViewBag.FornecedorId"></select> 
			@* Pegar do fornecedor e dar o select de todos os fornecedores, trazer id e nome,
			asp-for é i d do html o nome q vc vai pegar o valor do campo*@
			<label> DATA DE VENCIMENTO</label>
			<input asp-for="DataVencimento" type="date" />
			<button type="submit">Salvar</button>
		</form>
	</div>